    _output =
      _genesis_block.hash;
  }
  else if ( _output_type == "" ) {
    _output =
      _genesis_block;
  }
  if ( _output_file != undefined &&
       _output_file != "" ) {
    _file_write(
      _output_file,
      _output);
  }
  return _output;
}

function
  _config_show() {
  let
    _line,
    _text;
  _text = [
    `  ${app_name} configuration:`,
    `   Target network: ${target_network}`,
    `          API key: ${api_key_path}`,
    `      Output file: ${output_file}`,
  ]
  for ( _line of _text ) {
    _msg_info(
      _line);
  }
}

function
  _usage(
    _exit_code) {
  let
    _line;
  const
    _exit_code_type =
      typeof(
        _exit_code);
  if ( _exit_code_type == "undefined" ||
       _exit_code == "" ) {
    _exit_code =
      0;
  }
  const
    _argv =
      _argv_get();
  const
    _program =
      _basename(
        _argv[
          "$0"]);
  const
    _text = [
      "Displays current block for a blockchain.",
      "",
      "usage:",
      `  ${_program}`,
      "  ( <quiet>",
      "    <target-network>",
      "    <api-key-path>",
      "    <output-file> )",
      "",
      "args:",
      "",
      "  quiet              It can be 'y' or 'n'.",
      "",
      "  target-network     Chain ID or RPC address.",
      "",
      "  api-key-path       Etherscan-like service API key, optional.",
      "",
      "  output-file        If specified will save the output",
      "                     to a file, otherwise will print it.",
      "",
      "options:",
      "",
      "  -h, --help         Displays this help.",
      ""
    ];
  for ( _line of _text ) {
    console.log(
      _line);
  }
  if ( -1 < _exit_code ) {
    _exit(
      _exit_code);
  }
}


function _cmdline_parse() {
  quiet =
    "y";
  process.argv.forEach(
    function (
      _value,
      _index,
      _array) {
      if ( _index == 2 ) {
        quiet =
          _value;
      }
      if ( _index == 3 ) {
        target_network =
          _value;
      }
      if ( _index == 4 ) {
        api_key_path =
          _value;
      }
      if ( _index == 5 ) {
        output_file =
          _value;
      }
      if ( _value == "-h" ||
           _value == "--help" ) {
        _overrides_set();
        quiet =
          "n";
        _usage(
          0);
      }
  });
}

function
  _overrides_set() {
  _override_set(
    "chain",
    "id",
    "100");
  }
}

async function 
  _block_get_cmdline(
    _app_opts) {
  const
    _block =
      await _block_get.apply(
        null,
        _app_opts);
  console.log(
    _block);
}

if ( _cmdline_check(
       "block-get") ||
     _cmdline_check(
       "block") ) {
  _global_variables();
  _cmdline_parse();
  _overrides_set();
  _config_show();
  app_opts = [
    target_network,
    api_key_path,
    chain_id,
    chain_name,
    output_file
  ];
  _block_get_cmdline(
    app_opts);
}

module.exports = {
  _block_get:
