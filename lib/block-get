    _wallet_dir,
    _wallet_password,
    _wallet_path_list;
  _api_key =
    "";
  const
    _api_key_path_type =
      typeof(
        _api_key_path);
  const
    _output_type_type =
      typeof(
        _output_type);
  if ( _output_type_type == "undefined" ) {
    _output_type =
      "";
  }
  if ( _api_key_path_type == "string" ) {
    if ( _api_key_path != "" ) {
      if ( _file_exists(
             _api_key_path) )
      _api_key =
        _file_read(
          _api_key_path);
    }
  }
  _provider_get_opts = [
    _target_network,
    _api_key,
    _chain_id,
    _chain_name
  ];
  _provider =
    _provider_get.apply(
      null,
      _provider_get_opts);
  _msg_info_provider_generated(
    _provider);
  const
    _block =
      _provider.getBlock(
        0);
