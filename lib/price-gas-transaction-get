    console.log(
      _price_gas.toString());
    // process.stdout.write(
    //   _balance.toString());
  }
  catch(
    _error) {
    _msg_error(
      _error,
      1);
  }
}

if ( await _cmdline_check(
       "price-gas-transaction-get") ) {
  _global_variables();
  _cmdline_parse();
  _config_show();
  app_opts = [
    target_network,
    selection_mode,
    api_key,
    display_unit,
    wallet_seed,
    target_address,
    output_type,
    output_file,
    retries_max
  ];
  _price_gas_transaction_get_cmdline(
    app_opts);
}

