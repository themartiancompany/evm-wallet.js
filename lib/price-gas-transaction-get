async function
  _price_gas_transaction_get(
    _target_network,
    _selection_mode,
    _api_key_path,
    _display_unit,
    _wallet_seed,
    _target_address,
    _output_file,
    _retries_max) {
  let
    _fee_data,
    _msg,
    _price_gas,
    _price_gas_target,
    _price_gas_get_args,
    _provider_get_opts,
    _retry,
    _request,
    _success,
    _wallet_dir,
    _wallet_password,
    _wallet_path_list;
  _price_gas_get_args =
    [];
  if ( typeof(
         _selection_mode) == 'undefined' ||
       _selection_mode == "" ) {
    _selection_mode =
      "auto";
    _msg =
      "No selection mode set. " +
      `Setting '${_selection_mode}'.`;
    _msg_info(
      _msg);
  }
  if ( typeof(
         _output_type) == 'undefined' ||
       _output_type == "" ) {
    _output_type =
      "price";
  }
  if ( typeof(
         _retries_max) == 'undefined' ||
       _retries_max == "" ) {
    _retries_max =
      3;
  }
  else {
    _retries_max =
      Number(
        _retries_max);
  }
  if ( typeof(
         _display_unit) == 'undefined' ||
       _display_unit == "" ) {
    _display_unit =
      "ether";
  }
  _timeout =
    100000;
  _retry =
    0;
  _success =
    false;
  _wallet_password =
    "";
  _wallet_dir =
    _dirname(
      _wallet_seed);
  _wallet_path_list = [
    _wallet_dir,
    "wallet.dat"
  ];
  _wallet_path =
    _path_join(
      _wallet_path_list);
  _provider_get_opts = [
    _target_network,
  ];
  if ( _output_file == undefined ) {
    _output_file =
      "";
  }
  if ( _api_key_path != "" ) {
    _api_key =
      _file_read(
        _api_key_path);
    _provider_get_opts.push(
      _api_key);
  }
  _provider_get_opts.push(
    _timeout);
  _provider =
    await _provider_get.apply(
      null,
      _provider_get_opts);
  _msg_info_provider_generated(
    _provider);
  // if ( _target_address == "" ) {
  //   _wallet_get_opts = [
  //     _wallet_path,
  //     _wallet_password,
  //     _wallet_seed,
  //     _provider
  //   ];
  //   _wallet =
  //     _wallet_get.apply(
  //       null,
  //       _wallet_get_opts);
  //   _target_address =
  //     _wallet.address;
  // }
  while ( _success == false &&
          _retry < _retries_max ) {
    try {
      _price_gas_get_args.push(
        _target_network,
        _api_key_path,
        _display_unit,
        _wallet_seed,
        _target_address,
        _output_type,
        "", // Output file
        _retries_max);
      _price_gas = await
        _price_gas_get.apply(
          null,
          _price_gas_get_args);
      _msg =
        `Got gas price '${_price_gas}' ${_display_unit} ` +
        `of output type '${_output_type}' ` +
        `for network '${_target_network}'.`;
      _msg_info(
        _msg);
      _price_gas =
        Number(
          _price_gas);
      if ( _selection_mode == "auto" ) {
        _selection_mode =
          "rpc";
      }
      if ( _selection_mode == "simple" ) {
        _price_gas_target =
          Math.floor(
            _price_gas * 12 / 10);
      }
      else if ( _selection_mode == "fast" ) {
        _price_gas_target =
          Math.floor(
            _price_gas * 20 / 10 );
      }
      else if ( _selection_mode == "nextblock" ) {
        _price_gas_target =
          Math.floor(
            _price_gas * 50 / 10 );
      }
      else if ( _selection_mode == "rpc" ) {
        _price_gas_target =
          _price_gas;
      }
      else {
        _msg =
          `Unknown selection mode '${_selection_mode}'.`;
        _msg_error(
          _msg,
          1);
      }
      if ( _output_file != "" ) {
          _file_write(
            _output_file,
            _price_gas_target.toString());
      }
      _success =
        true;
    } catch(
        _err) {
      _retry =
        _retry + 1;
      _msg =
        `Error retrieving gas price, ` +
	`retrying (${_retry} of ${_retries_max})`;
      console.error(
        _err);
      _msg_error(
        _msg,
        0);
      await _sleep(
        3000);
    }
  }
  if ( _success == false &&
       _retry == _retries_max ) {
    throw "Error retrieving balance.";
  }
  return _price_gas_target;
}

