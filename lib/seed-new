/* Crash Javascript global variables */

/* global
     quiet:
       writable */

const
  _libcrash =
    await import(
      "libcrash-js");
/* global
     _argv_get */
const
  _argv_get =
    _libcrash._argv_get;
/* global
     _cmdline_check */
const
  _cmdline_check =
    _libcrash._cmdline_check;
/* global
     _dirname */
const
  _dirname =
    _libcrash._dirname;
/* global
     _echo */
const
  _echo =
    _libcrash._echo;
/* global
     _exit */
const
  _exit =
    _libcrash._exit;
/* global
     _file_exists */
const
  _file_exists =
    _libcrash._file_exists;
/* global
     _file_write */
const
  _file_write =
    _libcrash._file_write;
/* global
     _global_get */
const
  _global_get =
    _libcrash._global_get;
/* global
     _msg_info */
const
  _msg_info = 
    _libcrash._msg_info;
/* global
     _msg_info_obj */
const
  _msg_info_obj = 
    _libcrash._msg_info_obj;
/* global
     _msg_error */
const
 _msg_error = 
   _libcrash._msg_error;
/* global
     _require */
const
  _require =
    _libcrash._require;
/* global
     _set */
const
  _set =
    _libcrash._set;
const
  _ethers_module =
    await _require(
      "ethers");
/* global
     _ethers */
const
  _ethers = 
    _ethers_module.ethers;
/* global
     _wallet_class */
const
  _wallet_class =
    _ethers.Wallet;

function
  _global_variables() {
  /* global
       app_name:
         writable */
  _set(
    "app",
    "name",
    "seed-new");
  /* global
       seed_path:
         writable */
  _set(
    "seed",
    "path",
    "");
  seed_path =
    "";
  const
    _global =
      _global_get();
  _global[
    "quiet"] =
    "";
}

function
  _dir_missing_error(
    _dir) {
  const
    _msg =
      `The directory '${_dir}' does not exist.`;
  _msg_error(
    _msg,
    1)
}

function
  _msg_info_seed_write(
    _path) {
  const
    _msg =
      `Writing seed to '${_path}'.`;
  _msg_info(
    _msg);
}

function
  _msg_info_seed_written(
    _path) {
  const
    _msg =
      `Seed written to '${_path}'.`;
  _msg_info(
    _msg);
}

function
  _mkseed(
    _path) {
  const
    _wallet =
      _wallet_class.createRandom();
  const
    _phrase =
      _wallet.mnemonic.phrase;
  if ( _path != "" ) {
    const
      _dir =
        _dirname(
          _path);
    const
      _dir_exists =
        _file_exists(
          _dir);
    if ( ! _dir_exists ) {
      _dir_missing_error(
        _dir);
    }
    else {
      if ( quiet != "y" ) {
        _msg_info_seed_write(
          _path);
      }
    }
    _file_write(
      _path,
      _phrase);
    if ( quiet != "y" ) {
      _msg_info_seed_written(
        _path);
    }
  }
  else {
    _echo(
      _phrase);
  }
}

function
  _config_show() {
  let
    _line;
  const
    _text = [
      `${app_name} configuration:`,
      `        Seed path: ${seed_path}`,
    ]
  for ( _line of _text ) {
    _msg_info(
      _line);
  }
}


function
  _usage(
    _exit_code) {
  let
    _line;
  const
    _text = [
      "Usage:",
      "  mkseed",
      "   ( <path> )",
      "   ( <verbose> )"
    ];
  for ( _line of _text ) {
    _echo(
      _line);
  }
  _exit(
    _exit_code);
}

function
  _cmdline_parse() {
  const
    _global =
      _global_get();
  _global[
    "quiet"] =
    "y";
  _argv.forEach(
    function (
      _value,
      _index) {
      if ( _index == 2 ) {
        _set(
          "seed",
          "path",
          _value);
      }
      if ( _index == 3 ) {
        _global[
          "quiet"} =
          _value;
      }
  });
  if ( seed_path == "-h" ) {
    _usage(
      0);
  }
}


if ( await _cmdline_check(
       "seed-new") ||
     await _cmdline_check(
       "mkseed")  ) {
  _global_variables();
  await _cmdline_parse();
  app_opts = [
    seed_path
  ];
  _mkseed.apply(
    null,
    app_opts);
}

export {
  _mkseed
};

