{ "name": "evm-wallet.js",
  "version":
    "0.0.79",
  "description":
    "Cryptocurrency wallet for Ethereum Virtual Machine (EVM) compatible blockchain networks written in Javascript, part of the EVM Toolchain, depending on the Ethers library.",
  "funding": {
    "type":
      "patreon",
    "url":
      "https://patreon.com/tallero"
  },
  "man": [
    "./man/block-number.1",
    "./man/eoa-fingerprint.1",
    "./man/ether2wei.1",
    "./man/evm-wallet.1",
    "./man/evm-wallet.js.1",
    "./man/gas-transfer.1",
    "./man/mkseed.1"
  ],
  "files": [
    "AUTHORS.rst",
    "COPYING",
    "README.md",
    "dist",
    "lib",
    "libevm-wallet",
    "libevm-wallet.webpack.config.cjs",
    "evm-wallet",
    "fs-worker.webpack.config.cjs",
    "package.json",
    "serve.json",
    "webpack.config.cjs"
  ],
  "keywords": [
    "ur",
    "themartiancompany",
    "dogeos",
    "ethereum",
    "evmfs",
    "libevm",
    "evm-toolchain"
  ],
  "homepage":
    "https://github.com/themartiancompany/evm-wallet",
  "bugs": {
    "url":
      "https://github.com/themartiancompany/evm-wallet.js/issues"
  },
  "repository": {
    "type":
      "git",
    "url":
      "git+https://github.com/themartiancompany/evm-wallet.js.git"
  },
  "license":
    "AGPL-3.0-or-later",
  "author": {
    "name":
      "Pellegrino Prevete",
    "email":
      "pellegrinoprevete@gmail.com",
    "url":
      "https://github.com/tallero"
  },
  "devDependencies": {
    "crash-js-webpack":
      "^0.0.62",
    "flatted":
      "^3.4.4",
    "eslint":
      "^10.9.0",
    "globals":
      "^17.3.0",
    "@eslint/js":
      "^10.0.1",
    "safely-serve":
      "^0.0.18",
    "webpack":
      "^5.109.2",
    "webpack-cli":
      "^7.2.2",
    "ws":
      "8.21.0"
  },
  "dependencies": {
    "libcrash-js":
      "npm:crash-js@^100000001.1000000000000001.1000000000000001",
    "ethers":
      "^6.13.2",
    "libevm":
      "^0.0.36",
    "yargs":
      "18.0.0"
  },
  "optionalDependencies": {
    "erc20-tools":
      "^0.0.19"
  },
  "overrides": {
    "evm-wallet":
      "./libevm-wallet",
    "libevm":
      "^0.0.36"
  },
  "type":
    "module",
  "main":
    "libevm-wallet",
  "bin":
    { 
      "block":
        "lib/block-get",
      "block.js":
        "lib/block-get",
      "block-number":
        "lib/block-number-get",
      "block-number.js":
        "lib/block-number-get",
      "eoa-fingerprint":
        "lib/address-get",
      "eoa-fingerprint.js":
        "lib/address-get",
      "evm-wallet":
        "evm-wallet",
      "evm-wallet.js":
        "evm-wallet",
      "ether2wei":
        "lib/ethers-to-wei",
      "ether2wei.js":
        "lib/ethers-to-wei",
      "ether-to-wei":
        "lib/ethers-to-wei",
      "ether-to-wei.js":
        "lib/ethers-to-wei",
      "ethers-to-wei":
        "lib/ethers-to-wei",
      "ethers-to-wei.js":
        "lib/ethers-to-wei",
      "gas-balance":
        "lib/balance-get",
      "gas-balance.js":
        "lib/balance-get",
      "gas-level":
        "lib/balance-get",
      "gas-level.js":
        "lib/balance-get",
      "gas-transfer":
        "lib/balance-send",
      "gas-transfer.js":
        "lib/balance-send"
    },
  "yargs": {
    "parse-numbers":
      false,
    "parse-positional-numbers":
      false
  },
  "scripts": {
    "build-bin":
      "npx webpack --mode 'production' --config 'webpack.config.cjs' --stats-error-details && mv 'evm-wallet.js' 'dist/evm-wallet'",
    "build-fs-worker":
      "npx webpack --mode 'production' --config 'fs-worker.webpack.config.cjs' --stats-error-details && cp 'fs-worker.js' 'dist/evm-wallet' && cp 'fs-worker.js' 'dist/libevm-wallet'",
    "build-lib":
      "npx webpack --mode 'production' --config 'libevm-wallet.webpack.config.cjs' --stats-error-details && mv 'libevm-wallet.js' 'dist/libevm-wallet'",
    "build-man":
      "make build-man",
    "build":
      "npm run lint && npm run build-fs-worker && npm run build-lib && npm run build-bin",
    "lint":
      "npx eslint .",
    "publish-pnm":
      "npm run build && npm publish --access public",
    "start":
      "npx safely-serve 'dist/evm-wallet' --port 3000 --https --no-cache",
    "test":
      "echo \"Error: no test specified\" && exit 1"
  }
}
