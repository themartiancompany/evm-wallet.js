async function
  _conf_dir_get() {
  const
    _home =
      _homedir_get();
  const
    _app_name =
      "evm-wallet";
  const
    _msg =
      "Auto-detecting " +
      "config file. Setting " +
      "canonical XDG_CONFIG_DIR " +
      `'${_app_name}'.`;
  const
    _config_dir =
      `${_home}/.config/${_app_name}`;
  return _config_dir;
}

async function
  _balance_update(
    _cache_dir,
    _wallet_name,
    _wallet_seed,
    _target_networks,
    _rpc,
    _api_key,
    _measure_unit,
    _retries_max,
    _balance_lifespan,
    _call_timeout) {
  let
    _balance_dir,
    _balance_file,
    _balance_file_modified,
    _balance_get_args,
    _life,
    _network;
  const
    _balance =
      {};
  for ( _network of _target_networks ) {
    const
      _balance_dir =
        _path_join( [
          _cache_dir,
          _wallet_name,
          _network.toString() ]);
    const
      _balance_file =
        _path_join( [
          _balance_dir,
          "balance"]);
    const
      _balance_get_args = [
        _wallet_seed,
        _rpc[
          _network],
        _api_key,
        "",                  // Target address, using seed
        _measure_unit,
        _balance_file,
        _retries_max,
        _call_timeout
      ];
    if ( ! _file_exists(
             _balance_dir) ) {
      _mkdir(
        _balance_dir,
        { "recursive":
            true });
    }
    if ( ! _file_exists(
             _balance_file) ) {
      _balance[
        _network] =
        await _balance_get.apply(
          null,
          _balance_get_args);
    }
    else {
      const
        _balance_file_modified =
          _stat(
            _balance_file).mtimeMs;
      const
        _life =
          Date.now() -
          _balance_file_modified;
      if ( _balance_lifespan < _life ) {
        _balance[
          _network] =
          await _balance_get.apply(
            null,
            _balance_get_args);
      }
      else {
        _balance[
          _network] =
          _cat(
            _balance_file);
      }
    }
  }
  return _balance;
}

async function
  _wallet_address_get(
    _config_dir,
    _wallet_name,
    _wallet_seed) {
  let
    _address_get_args,
    _error,
    _msg,
    _wallet_address,
    _wallet_address_get_args;
  if ( _config_dir == "" ||
       typeof(_config_dir) === "undefined" ) {
    _config_dir =
      _conf_dir_get();
  }
  if ( _wallet_name == "" ||
       typeof(
         _wallet_name) === "undefined" ) {
    if ( _wallet_seed == "" ||
       typeof(
         _wallet_seed) == "undefined" ) {
      _msg =
        "Either one between the wallet name " +
        "or the wallet seed argument must be non-empty. " +
        "_wallet_address_get(_config_path, " +
        "_wallet_name, _wallet_seed)";
      _error = {
        "message":
          _msg
      };
      throw _error;
    }
    const
      _address_get_args = [
        _wallet_seed,
        "",                       // Network
        "",                       // API Key
        "",                       // Chain ID
        "",                       // Chain name
        ""                        // Output file
      ];
    _wallet_address =
      await _address_get.apply(
        null,
        _address_get_args);
  }
  else if ( _wallet_name != "" ) {
    const
      _wallet_address_path =
        `${_config_dir}/${_wallet_name}-address.txt`;
    if ( _file_exists(
           _wallet_address_path) ) {
      _wallet_address =
        _file_read(
          _wallet_address_path);
    }
    else {
      if ( _file_exists(
             _wallet_seed) ) {
        const
          _address_get_args = [
            _wallet_seed,
            "",                   // Network
            "",                   // API Key
            "",                   // Chain ID
            "",                   // Chain name
            _wallet_address_path  // Output file
          ];
        _wallet_address =
          await _address_get.apply(
            null,
            _address_get_args);
      }
      else {
        _msg =
          "Found no recorded address nor seed for " +
          `name '${_wallet_name}' in '${_config_dir}'.`;
        _error = {
          "message":
            _msg
        };
        throw _error;
      }
    }
  }
  else {
    _msg =
      "Argument 'wallet name' must " +
      "be of type 'string'.";
    _error = {
      "message":
        _msg
    };
    throw _error;
  }
  return _wallet_address;
}

async function
  _wallets_files_get(
    _config_dir,
    _filter) {
  let
    _regexp,
    _wallet,
    _wallet_name,
    _wallet_path;
  const
    _wallets_files =
     [];
  const
    _wallets =
      await _ls(
        _config_dir);
  const
    _data_types = [
      "address",
      "fingerprint",
      "seed"
    ];
  for ( _wallet of _wallets ) {
    for ( _data_type of _data_types ) {
      if ( _wallet.endsWith(
             `-${_data_type}.txt`) ) {
        _regexp =
          RegExp(
            `-${_data_type}.txt$`);
        _wallet_name =
          _wallet.replace(
            _regexp,
            "");
        if ( _wallet_name.includes(
               `${_filter}`) ) {
          _wallet_path =
            _path_join([
              _config_dir,
              _wallet
            ]);;
          _wallet_files.push(
            _wallet_path);
        }
      }
    }
  }
