async function
  _contacts_list(
    _filter,
    _output_type,
    _config_dir) {
  let
    _regexp,
    _wallets_files;
  const
    _addresses =
      {};
  const
    _fingerprints =
      {};
  const
    _wallets =
      {};
  if ( _filter == "" ) {
    _filter =
      "*";
  }
  _wallets_files =
    await _wallets_files_get(
      _config_dir,
      _filter);
  _wallets_files =
    _wallet_sort(
      _wallet_files);
  for ( _wallet of _wallet_files ) {
    _file_name =
      _basename(
        _wallet);
    if ( _file_name.endsWith(
           "-seed.txt") ) {
      _regexp =
        RegExp(
          "-seed.txt$");
      _wallet_name =
        _file_name.replace(
          _regexp,
          "");
      _wallet_path =
        _path_join([
          _config_dir,
          _file_name
        ];
      _wallets[
        _wallet_name] =
        _wallet_path;
    }
    else if ( _file_name.endsWith(
                "-address.txt") ) {
      _regexp =
        RegExp(
          "-address.txt$");
      _wallet_name =
        _file_name.replace(
          _regexp,
          "");
      _addresses[
        _wallet_name] =
        _cat(
          _wallet);
      if ( _output_type == "" ||
           _output_type == "fingerprint" ) {
        _msg =
          "Getting fingerprint for"
          `contact '${_wallet_name}'.`;
        _msg_info(
          _msg);
        const
          _fingerprint =
            await _fingerprint_get(
              _wallet_name);
      }
    }
  }
}

async function
  _transfer(
    _target_address,
    _target_amount,
    _target_network,
    _currenty_type,
    _retries_max,
    _call_timeout,
    _wallet_seed,
    _api_key,
    _rpc,
    _currency_address,
    _measure_unit) {
  if ( _currency_type == "gas" ) {
    const
      _balance_send_args = [
        _wallet_seed,
        _target_address,
        _target_amount,
        _rpc[
          _target_network],
        _api_key,
        _measure_unit
      ];
    const
      [ _tx,
        _receipt ] =
        await _balance_send.apply(
          null,
          _balance_send_args);
    return [ _tx,
             _receipt ];
  }
  else if ( _currency_type == "erc20" ) {
    try {
      const
        _erc20_tools_module =
          await _require(
            "erc20-tools");
      const
        _token_send =
          _erc20_tools_module._token_send;
      const
        _token_send_args = [
          _retries_max,
          _call_timeout,
          _wallet_seed,
          _api_key,
          _rpc,                          // NOTE: data filled-in
          _currency_address,             // by 'token-send':
          "",                            //   erc20 abi
          "",                            //   erc20 bytecode
          "",                            //   erc20 hardhat artifact
          _measure_unit,
          "",                            // output path
          _target_address,
          _target_amount
        ];
      _msg =
        `Running '_token_send' with ` +
        `arguments '${_token_send_args}'.`;
      _msg_info(
        _msg);
      const
        _token_sent =
          await _token_send.apply(
            null,
            _token_send_args);
      return _token_sent;
    }
    catch(
      _error) {
      _msg =
        "Install ERC-20 Tools ('ur erc20-tools')";
      const
        _exception = {
          "msg":
            _msg
        };
      _msg_error(
        _msg,
        0);
      throw _exception;
    }
  }
  else {
    _msg =
      `Unknown currency type '${_currency_type}'.`;
    _msg_error(
      _msg,
      1);
  }
}

async function
  _evm_wallet(
    _target_command,
    _wallet_name,
    _wallet_path,
    _wallet_password,
    _wallet_seed,
    _key_fingerprint,
    _config_dir,
    _cache_dir,
    _networks_all,
    _rpc_selection,
    _api_key,
    _retries_max,
    _tasks_parallel,
    _call_timeout,
    _measure_unit,
    _balance_lifespan,
    _currency_type,
    _currency_address,
    _output_type,
    _target_key,
    _target_value,
    _target_networks) {
  let
    _msg,
    _network,
    _target_network,
    _tx,
    _receipt;
  const
    _libevm_module =
      await _require(
        "libevm");
  const
    _rpc_get =
      _libevm_module._rpc_get;
  [ _target_networks,
    _target_network ] =
    _target_networks_check(
      _target_networks);
  const
    _rpc =
      _rpc_get(
        _target_networks);
  _msg =
    `Using RPC address:`;
  _msg_info(
    _msg);
  if ( quiet == "n" ) {
    console.log(
      _rpc);
  }
  if ( _target_command == "blocknumber" ) {
    const
      _block_number_get_args = [
        _rpc[
          _target_network],
        _api_key,
        "",            // output file
        _retries_max,
        _call_timeout,
      ];
    const
      _block_number =
        await _block_number_get.apply(
          null,
          _block_number_get_args);
    return _block_number;
  }
  else if ( _target_command == "gas" ) {
    const
      _price_gas_get_args = [
        _rpc[
          _target_network],
        _api_key,
        _measure_unit,
        "",            // seed
        "",            // target address
        "",            // output file
        _retries_max
      ];
    const
      _price_gas =
        await _price_gas_get.apply(
          null,
          _price_gas_get_args);
    return _price_gas;
  }
  else if ( _target_command == "get" ) {
    if ( _target_key == "balance" ) {
      const
        _balance_update_args = [
          _cache_dir,
          _wallet_name,
          _wallet_seed,
          _target_networks,
          _rpc,
          _api_key,
          _measure_unit,
          _retries_max,
          _balance_lifespan,
          _call_timeout
        ];
      const
        _balance =
          await _balance_update.apply(
            null,
            _balance_update_args);
      return _balance;
    }
    else if ( _target_key == "address" ) {
      const
        _wallet_address_get_args = [
          _config_dir,
          _wallet_name,
          _wallet_seed,
        ];
      const
        _wallet_address =
          await _wallet_address_get.apply(
            null,
            _wallet_address_get_args);
      return _wallet_address;
    }
    else {
      _msg =
        `Unknown key '${_target_key}'.`;
      _msg_error(
        _msg,
        1);
    }
  }
  else if ( _target_command == "send" ) {
    const
      _target_address =
        _target_key;
    const
      _target_amount =
        _target_value;
    const
      _transfer_args = [
        _target_address,
        _target_amount,
        _target_network,
        _currenty_type,
        _retries_max,
        _call_timeout,
        _wallet_seed,
        _api_key,
        _rpc,
        _currency_address,
        _measure_unit) {
      ];
    const
      [ _tx,
        _receipt ] =
        await _transfer.apply(
          null,
          _transfer_args);
      return [
        _tx,
        _receipt ];
    }
  }
  else if ( _target_command == "list" ) {
    const
      _filter =
        _target_key;
    const
      _contacts_list_args = [
        _filter,
        _output_type
      ];
    const
      _contacts =
        await _contacts_list.apply(
          null,
          _contacts_list_args);
    return _contacts;
  }
  else if ( _target_command == "run" ) {
    true;
  }
  else {
    _msg =
      `Unknown command '${_target_command}'.`;
    _msg_error(
      _msg,
      0);
    const
      _exception =
        "msg":
          _msg
      };
    throw _msg;
  }
}

